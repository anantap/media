---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { ratingDots, groupByYear } from '../../lib/utils';

export async function getStaticPaths() {
  const all = await getCollection('log', ({ data }) => !data.draft);
  const types = [...new Set(all.map(e => e.data.type))];

  return types.map(type => {
    const entries = all
      .filter(e => e.data.type === type)
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
    return { params: { type }, props: { entries } };
  });
}

const { type } = Astro.params;
const { entries } = Astro.props;

const byYear = groupByYear(entries);
const years = [...byYear.keys()].sort((a, b) => b - a);

const typeLabel = type.charAt(0).toUpperCase() + type.slice(1);
const total = entries.length;
---

<Base
  title={typeLabel}
  description={`${total} ${type === 'films' ? 'films' : type + 's'} — Medialog`}
>
  <a href="/" class="back-link">← Alles</a>

  <div class="page-intro">
    <h1 class="page-intro__title">{typeLabel}</h1>
    <p class="page-intro__desc">{total} {total === 1 ? 'entry' : 'entries'}</p>
  </div>

  {years.map(year => {
    const yearEntries = byYear.get(year)!;
    return (
      <section class="year-group">
        <h2 class="year-heading">{year}</h2>
        <ul class="entry-list">
          {yearEntries.map(entry => (
            <li>
              <div class="entry-row">
                <span class="type-chip">{entry.data.type}</span>
                <a href={`/log/${entry.slug}/`} class="entry-row__title">{entry.data.title}</a>
                <span class="entry-row__meta">{entry.data.creator}</span>
                <span class="entry-row__year">{entry.data.year}</span>
                <span class="entry-row__rating" aria-label={`${entry.data.rating} van 5`}>
                  {ratingDots(entry.data.rating)}
                </span>
              </div>
            </li>
          ))}
        </ul>
      </section>
    );
  })}

  {entries.length === 0 && (
    <p class="empty-state">Geen {type}-entries gevonden.</p>
  )}
</Base>
